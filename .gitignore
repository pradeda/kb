# Secrets
.env

# Database (built from raw notes via compile.py)
kb.db
kb.db-shm
kb.db-wal

# Vector store
chroma_data/
chroma/

# Python environments
venv*/
__pycache__/

# Model cache
fastembed_cache/

# Backup / rollback copies
*.bak*
*.pre-*

# Raw notes (backed up to NAS separately)
raw/

# Generated wiki
wiki/
wiki.backup*/

# Quarantine
quarantine/
quarantine.log*

# Atlas generated output
atlas/
hf_cache/

# Stray corpus DB created when kb runs from the repo root
ai-kb.db

# Eval run reports (generated by eval_runner.py / eval_rewrite_runner.py;
# the harness, test sets and fixtures under eval/ stay tracked)
eval/report-*.json
eval/rewrite-report-*.json
