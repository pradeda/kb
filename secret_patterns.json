{
  "version": 1,
  "note": "Shared secret-scanner rules read by kb-go (Gate 1, write-time) and compile.py (Gate 2, embed-time). RE2-compatible subset only (no backreferences/lookaround) so Go and Python match identically. Patterns are applied in order; specific before generic. capture_group 0 = redact whole match, N = redact only that group. confidence high = match is proof (skip entropy); low = value must pass min_len + min_entropy. action redact = mutate content in place; log = record only, do not mutate.",
  "patterns": [
    {"name": "ssh_private_key",      "regex": "-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY-----[\\s\\S]*?-----END (?:[A-Z0-9]+ )?PRIVATE KEY-----", "placeholder": "<REDACTED_SSH_PRIVATE_KEY>", "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "openrouter_key",       "regex": "sk-or-v1-[0-9a-f]{64}",                                    "placeholder": "<REDACTED_OPENROUTER_KEY>",  "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "anthropic_key",        "regex": "sk-ant-[A-Za-z0-9_-]{20,}",                                "placeholder": "<REDACTED_ANTHROPIC_KEY>",   "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "openai_key",           "regex": "sk-(?:proj-)?[A-Za-z0-9]{20,}",                            "placeholder": "<REDACTED_OPENAI_KEY>",      "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "github_pat",           "regex": "gh[pousr]_[A-Za-z0-9]{36}",                                "placeholder": "<REDACTED_GITHUB_TOKEN>",    "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "github_fine_pat",      "regex": "github_pat_[A-Za-z0-9_]{22,}",                             "placeholder": "<REDACTED_GITHUB_TOKEN>",    "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "gitlab_pat",           "regex": "glpat-[A-Za-z0-9_-]{20}",                                  "placeholder": "<REDACTED_GITLAB_TOKEN>",    "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "slack_token",          "regex": "xox[baprs]-[A-Za-z0-9-]{10,}",                             "placeholder": "<REDACTED_SLACK_TOKEN>",     "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "google_api_key",       "regex": "AIza[0-9A-Za-z_-]{35}",                                    "placeholder": "<REDACTED_GOOGLE_KEY>",      "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "stripe_key",           "regex": "[sr]k_live_[A-Za-z0-9]{24,}",                              "placeholder": "<REDACTED_STRIPE_KEY>",      "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "huggingface_token",    "regex": "hf_[A-Za-z0-9]{34}",                                       "placeholder": "<REDACTED_HF_TOKEN>",        "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "npm_token",            "regex": "npm_[A-Za-z0-9]{36}",                                      "placeholder": "<REDACTED_NPM_TOKEN>",       "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "sendgrid_key",         "regex": "SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}",               "placeholder": "<REDACTED_SENDGRID_KEY>",    "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "digitalocean_token",   "regex": "dop_v1_[a-f0-9]{64}",                                      "placeholder": "<REDACTED_DO_TOKEN>",        "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "aws_access_key",       "regex": "(?:AKIA|ASIA)[0-9A-Z]{16}",                                "placeholder": "<REDACTED_AWS_KEY>",         "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "jwt",                  "regex": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}", "placeholder": "<REDACTED_JWT>",       "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "telegram_bot_token",   "regex": "\\b[0-9]{8,10}:[A-Za-z0-9_-]{35}\\b",                      "placeholder": "<REDACTED_TELEGRAM_TOKEN>",  "action": "redact", "confidence": "high", "capture_group": 0, "min_len": 0, "min_entropy": 0},
    {"name": "url_basic_auth",       "regex": "(?i)\\b(?:https?|ftp|redis|postgres(?:ql)?|mysql|mongodb|amqp)://[^:@\\s/]+:([^@\\s/]+)@", "placeholder": "<REDACTED_URL_PASSWORD>", "action": "redact", "confidence": "high", "capture_group": 1, "min_len": 0, "min_entropy": 0},
    {"name": "http_basic_auth",      "regex": "(?i)authorization:\\s*basic\\s+([A-Za-z0-9+/=]{8,})",       "placeholder": "<REDACTED_BASIC_AUTH>",      "action": "redact", "confidence": "high", "capture_group": 1, "min_len": 0, "min_entropy": 0},
    {"name": "arr_api_key",          "regex": "(?i)api[_-]?key[\"'\\s:=]+([0-9a-f]{32})\\b",               "placeholder": "<REDACTED_API_KEY>",         "action": "redact", "confidence": "high", "capture_group": 1, "min_len": 0, "min_entropy": 0},
    {"name": "secret_assignment",    "regex": "(?i)(?:password|passwd|pwd|secret|client_secret|access[_-]?token|auth[_-]?token)[\"'\\s]*[:=][\"'\\s]*([^\\s\"']{6,})", "placeholder": "<REDACTED_SECRET>", "action": "redact", "confidence": "low", "capture_group": 1, "min_len": 6, "min_entropy": 0},
    {"name": "generic_secret_value", "regex": "(?i)(?:api[_-]?key|secret|token|access[_-]?key)[\"'\\s:=]+[\"']?([A-Za-z0-9_-]{24,})", "placeholder": "<REDACTED_SECRET>", "action": "log", "confidence": "low", "capture_group": 1, "min_len": 24, "min_entropy": 4.0}
  ],
  "allowlist": [
    "SONARR_API_KEY", "RADARR_API_KEY", "PROWLARR_API_KEY", "BAZARR_API_KEY",
    "KAVITA_API_KEY", "READARR_API_KEY", "API_KEY", "KEY", "changeme", "password", "passwd",
    "yourpassword", "example", "examplekey", "xxxx", "xxxxxxxx", "adminadmin"
  ],
  "allow_contains": [
    "<redacted_", "your_password", "your-password", "changeme", "example",
    "placeholder", "redacted", "xxxxxxxx", "dummy", "changethis", "notreal"
  ]
}
